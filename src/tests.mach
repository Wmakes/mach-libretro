# Small native regression tests; comprehensive header comparisons are in tools/test.py.
use libretro.c;

test libretro__scalar_abi {
    if ($size_of(u8) != 1 || $size_of(i16) != 2 || $size_of(u32) != 4)                               { ret 1; }
    if ($size_of(c.size_t) != $size_of(ptr))                                                         { ret 2; }
    if ($size_of(c.retro_environment_t) != $size_of(ptr))                                            { ret 3; }
    if ($size_of(c.retro_system_info) != 32 || $offset_of(c.retro_system_info, block_extract) != 25) { ret 4; }
    if ($size_of(c.retro_system_av_info) != 40 || $offset_of(c.retro_system_av_info, timing) != 24)  { ret 5; }
    ret 0;
}

test libretro__macro_semantics {
    if (c.RETRO_DEVICE_SUBCLASS(1, 0) != 257)                            { ret 1; }
    if (c.RETRO_SENSOR_SUBDEVICE(3, 6) != 774)                           { ret 2; }
    if (c.RETRO_SENSOR_INDEX(774) != 3 || c.RETRO_SENSOR_BASE(774) != 6) { ret 3; }
    if (c.RETRO_HW_FRAME_BUFFER_VALID::u64 != 0xFFFFFFFFFFFFFFFFu64)     { ret 4; }
    if (c.RETRO_ENVIRONMENT_SET_HW_SHARED_CONTEXT != (44 | 0x10000))     { ret 5; }
    ret 0;
}
