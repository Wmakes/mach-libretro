# Sentinel and function-like header macros
pub val RETRO_HW_FRAME_BUFFER_VALID: ptr = 0xFFFFFFFFFFFFFFFFu64::ptr;

pub fun RETRO_DEVICE_SUBCLASS(base: u32, id: u32) u32 {
    ret ((id + 1) << 8) | base;
}

pub fun RETRO_SENSOR_INDEX(id: u32) u32 {
    ret id >> 8;
}

pub fun RETRO_SENSOR_BASE(id: u32) u32 {
    ret id & 255;
}

pub fun RETRO_SENSOR_SUBDEVICE(index: u32, id: u32) u32 {
    ret (index << 8) | id;
}

# Callback signatures, scalar aliases and records in header order
